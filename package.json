{
  "name": "three-nails-planner",
  "version": "0.1.1",
  "private": true,
  "description": "Три гвоздя — автономный планировщик задач",
  "main": "desktop/main.cjs",
  "author": "Three Nails",
  "scripts": {
    "build:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.threenails.planner",
    "productName": "Три гвоздя",
    "asar": true,
    "files": [
      "index.html",
      "install.js",
      "app.js",
      "style.css",
      "mobile.css",
      "mobile.js",
      "print.css",
      "print.js",
      "help.css",
      "help.js",
      "manifest.webmanifest",
      "icons/**",
      "assets/**",
      "desktop/**",
      "!desktop/README.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icons/desktop.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Три гвоздя",
      "artifactName": "Three-Nails-Setup-${version}-Windows-x64.exe"
    }
  }
}
